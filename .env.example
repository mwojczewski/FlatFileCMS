# FlatFile CMS — example local environment
# Copy this file to .env.local and replace every CHANGE_ME value.
# Never commit .env.local or real credentials.

# Application
APP_ENV=development
APP_DEBUG=1
APP_SECRET=CHANGE_ME_generate_at_least_32_random_bytes
APP_TIMEZONE=Europe/Warsaw

# Parsed YAML infrastructure caches
# This is a server/runtime concern. Website and media behavior belongs to
# config/setup.yml.
# Existing JSON representation:
YAML_CACHE_JSON_ENABLED=1
# Independent PHP serialize() cache. When both switches are enabled, the CMS
# writes both formats and uses serialized data first with JSON as a fallback.
YAML_CACHE_SERIALIZE_ENABLED=0

# Reverse proxy
# Comma-separated IP addresses or CIDR ranges. Leave empty when no trusted
# reverse proxy is used. Never trust every address in production.
TRUSTED_PROXIES=

# Administrator session
SESSION_NAME=flatfile_cms_session
SESSION_LIFETIME=7200
# Use 0 only for local HTTP development. Production HTTPS must use 1.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAME_SITE=Lax

# WebAuthn/FIDO2 security keys. RP ID is the exact admin hostname without
# scheme, port or path. WebAuthn requires HTTPS except on localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="FlatFile CMS"

# Authentication protection
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_RESET_MAX_ATTEMPTS=3
AUTH_RESET_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_TTL=3600

# Mail transport — local development example
MAIL_TRANSPORT=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="FlatFile CMS"
